    "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# --- 5b. Compute and plot confusion matrices ---\n",
    "for name, model in models.items():\n",
    "    print(f\"\\nEvaluating confusion matrix for {name}...\")\n",
    "    # Get test data & predictions\n",
    "    if name in ['FNN', 'Wide_Deep', 'Residual']:\n",
    "        X_eval, y_eval = X_test_scaled, y_test\n",
    "    else:\n",
    "        X_eval, y_eval = X_test_3d, y_test\n",
    "\n",
    "    y_pred_prob = model.predict(X_eval).flatten()\n",
    "    y_pred = (y_pred_prob > 0.5).astype(int)\n",
    "\n",
    "    # Compute confusion matrix\n",
    "    cm = confusion_matrix(y_eval, y_pred)\n",
    "    disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=model.classes_ if hasattr(model, 'classes_') else [0,1])\n",
    "\n",
    "    # Plot it\n",
    "    fig, ax = plt.subplots(figsize=(5, 5))\n",
    "    disp.plot(ax=ax, cmap='Blues', values_format='d')\n",
    "    plt.title(f\"{name} Confusion Matrix\")\n",
    "    plt.show()\n",
    "\n",
    "# --- 6. Plot ROC curves ---\n",
